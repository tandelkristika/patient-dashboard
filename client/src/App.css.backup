*{
box-sizing: border-box;
}

:root {
font-family:
Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
"Segoe UI", sans-serif;

color: #172033;
background: #f4f7fb;
}

body {
margin: 0;
min-width: 320px;
background: #f4f7fb;
}

button,
input,
textarea {
font: inherit;
}

button {
cursor: pointer;
}

button:disabled {
cursor: not-allowed;
opacity: 0.65;
}

.app {
min-height: 100vh;
}

/* Login */

.login-app {
display: flex;
align-items: center;
justify-content: center;
padding: 32px 20px;
background:
radial-gradient(circle at top left, #e8f2ff 0, transparent 35%),
#f4f7fb;
}

.login-card {
width: 100%;
max-width: 460px;
background: #ffffff;
border: 1px solid #e5eaf1;
border-radius: 20px;
padding: 38px;
box-shadow: 0 20px 60px rgba(30, 50, 80, 0.1);
}

.brand {
display: flex;
align-items: center;
gap: 14px;
margin-bottom: 42px;
}

.brand-icon {
width: 48px;
height: 48px;
display: flex;
align-items: center;
justify-content: center;
border-radius: 14px;
background: #2563eb;
color: white;
font-size: 30px;
font-weight: 700;
}

.brand-icon.small {
width: 38px;
height: 38px;
border-radius: 10px;
font-size: 24px;
}

.brand h1 {
margin: 0;
font-size: 18px;
line-height: 1.2;
}

.brand p {
margin: 4px 0 0;
color: #718096;
font-size: 13px;
}

.login-heading h2 {
margin: 0 0 8px;
font-size: 28px;
}

.login-heading p {
margin: 0 0 28px;
color: #718096;
}

.login-form {
display: flex;
flex-direction: column;
gap: 18px;
}

.login-form label,
.analysis-form label {
display: flex;
flex-direction: column;
gap: 8px;
color: #27364d;
font-size: 14px;
font-weight: 600;
}

input,
textarea {
width: 100%;
border: 1px solid #d7dee9;
border-radius: 10px;
padding: 12px 14px;
background: #fff;
color: #172033;
outline: none;
transition: border-color 0.2s, box-shadow 0.2s;
}

input:focus,
textarea:focus {
border-color: #2563eb;
box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
}

textarea {
resize: vertical;
line-height: 1.5;
}

.primary-button {
border: 0;
border-radius: 10px;
padding: 13px 18px;
background: #2563eb;
color: white;
font-weight: 700;
transition: background 0.2s, transform 0.1s;
}

.primary-button:hover:not(:disabled) {
background: #1d4ed8;
}

.primary-button:active:not(:disabled) {
transform: translateY(1px);
}

.error-box {
padding: 12px 14px;
border: 1px solid #fecaca;
border-radius: 10px;
background: #fef2f2;
color: #b91c1c;
font-size: 14px;
font-weight: 600;
}

.dashboard-error {
margin-bottom: 20px;
}

/* Topbar */

.dashboard-app {
background: #f4f7fb;
}

.topbar {
min-height: 70px;
padding: 0 32px;
display: flex;
align-items: center;
justify-content: space-between;
background: white;
border-bottom: 1px solid #e5eaf1;
}

.topbar-brand {
display: flex;
align-items: center;
gap: 11px;
}

.topbar-brand strong {
display: block;
font-size: 15px;
}

.topbar-brand span {
display: block;
margin-top: 2px;
color: #718096;
font-size: 12px;
}

.doctor-area {
display: flex;
align-items: center;
gap: 20px;
}

.doctor-info {
text-align: right;
}

.doctor-info strong {
display: block;
font-size: 14px;
}

.doctor-info span {
display: block;
margin-top: 2px;
color: #718096;
font-size: 12px;
}

.logout-button,
.refresh-button {
border: 1px solid #d7dee9;
border-radius: 8px;
padding: 8px 12px;
background: white;
color: #374151;
font-size: 13px;
font-weight: 600;
}

.logout-button:hover,
.refresh-button:hover:not(:disabled) {
background: #f8fafc;
}

/* Dashboard */

.dashboard {
width: 100%;
max-width: 1500px;
margin: 0 auto;
padding: 32px;
}

.welcome-section {
margin-bottom: 26px;
}

.welcome-section h1 {
margin: 0 0 6px;
font-size: 28px;
}

.welcome-section p {
margin: 0;
color: #718096;
}

.dashboard-grid {
display: grid;
grid-template-columns: 330px minmax(0, 1fr);
gap: 22px;
align-items: start;
}

.patients-panel,
.analysis-panel {
background: white;
border: 1px solid #e5eaf1;
border-radius: 16px;
}

.patients-panel {
overflow: hidden;
}

.panel-header {
display: flex;
align-items: center;
justify-content: space-between;
padding: 20px;
border-bottom: 1px solid #edf0f5;
}

.panel-header h2 {
margin: 0;
font-size: 17px;
}

.panel-header span {
display: block;
margin-top: 3px;
color: #718096;
font-size: 12px;
}

.patient-list {
padding: 8px;
}

.patient-item {
width: 100%;
display: flex;
align-items: center;
gap: 11px;
padding: 12px;
border: 0;
border-radius: 10px;
background: transparent;
text-align: left;
color: inherit;
}

.patient-item:hover {
background: #f7f9fc;
}

.patient-item.selected {
background: #eff6ff;
}

.patient-avatar {
flex: 0 0 auto;
width: 40px;
height: 40px;
display: flex;
align-items: center;
justify-content: center;
border-radius: 50%;
background: #dbeafe;
color: #1d4ed8;
font-weight: 800;
}

.patient-avatar.large {
width: 52px;
height: 52px;
font-size: 20px;
}

.patient-info {
min-width: 0;
flex: 1;
}

.patient-info strong {
display: block;
overflow: hidden;
text-overflow: ellipsis;
white-space: nowrap;
font-size: 14px;
}

.patient-info span {
display: block;
margin-top: 3px;
color: #718096;
font-size: 12px;
}

.arrow {
color: #9aa5b5;
font-size: 22px;
}

.empty-state {
padding: 30px 20px;
text-align: center;
color: #718096;
font-size: 14px;
}

/* Analysis */

.analysis-panel {
padding: 26px;
}

.select-patient-state {
min-height: 500px;
display: flex;
flex-direction: column;
align-items: center;
justify-content: center;
text-align: center;
padding: 30px;
}

.large-icon {
width: 70px;
height: 70px;
display: flex;
align-items: center;
justify-content: center;
margin-bottom: 18px;
border-radius: 20px;
background: #eff6ff;
color: #2563eb;
font-size: 42px;
font-weight: 300;
}

.select-patient-state h2 {
margin: 0 0 8px;
}

.select-patient-state p {
max-width: 420px;
margin: 0;
color: #718096;
line-height: 1.6;
}

.patient-header {
display: flex;
align-items: center;
gap: 14px;
padding-bottom: 22px;
border-bottom: 1px solid #edf0f5;
}

.patient-header h2 {
margin: 0 0 4px;
font-size: 21px;
}

.patient-header p {
margin: 0;
color: #718096;
font-size: 13px;
}

.medical-history {
padding: 22px 0;
border-bottom: 1px solid #edf0f5;
}

.medical-history h3,
.analysis-form h3,
.history-panel h3 {
margin: 0;
font-size: 16px;
}

.history-grid {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 12px;
margin-top: 14px;
}

.history-grid > div {
padding: 13px;
border-radius: 10px;
background: #f7f9fc;
}

.history-grid span {
display: block;
margin-bottom: 5px;
color: #718096;
font-size: 11px;
text-transform: uppercase;
letter-spacing: 0.04em;
}

.history-grid strong {
display: block;
font-size: 13px;
line-height: 1.4;
}

.analysis-form {
padding: 24px 0;
border-bottom: 1px solid #edf0f5;
}

.analysis-form {
display: flex;
flex-direction: column;
gap: 17px;
}

.section-title {
margin-bottom: 3px;
}

.section-title h3 {
margin-bottom: 5px;
}

.section-title p {
margin: 0;
color: #718096;
font-size: 13px;
}

.analysis-form small {
align-self: flex-end;
margin-top: -4px;
color: #8a95a5;
font-size: 11px;
font-weight: 400;
}

.analyze-button {
align-self: flex-start;
min-width: 160px;
}

/* Result */

.result-card {
margin-top: 24px;
padding: 22px;
border: 1px solid #dbe3ef;
border-radius: 14px;
background: #fbfdff;
}

.result-header {
display: flex;
align-items: flex-start;
justify-content: space-between;
gap: 15px;
margin-bottom: 20px;
}

.result-header h3 {
margin: 0 0 4px;
font-size: 17px;
}

.result-header span {
color: #718096;
font-size: 12px;
}

.risk-badge {
flex: 0 0 auto;
padding: 7px 11px;
border-radius: 999px;
font-size: 12px !important;
font-weight: 800;
}

.risk-low {
background: #dcfce7;
color: #166534 !important;
}

.risk-medium {
background: #fef3c7;
color: #92400e !important;
}

.risk-high {
background: #fee2e2;
color: #b91c1c !important;
}

.result-summary h4,
.result-section h4 {
margin: 0 0 8px;
font-size: 13px;
}

.result-summary p {
margin: 0;
color: #3f4b5f;
line-height: 1.6;
font-size: 14px;
}

.result-section {
margin-top: 20px;
}

.result-section ul {
margin: 0;
padding-left: 20px;
color: #3f4b5f;
line-height: 1.7;
font-size: 13px;
}

.warning-section {
padding: 13px 15px;
border-radius: 10px;
background: #fff7ed;
color: #9a3412;
}

.warning-section ul {
color: #9a3412;
}

.disclaimer {
margin-top: 20px;
padding: 12px;
border-radius: 8px;
background: #f1f5f9;
color: #64748b;
font-size: 11px;
line-height: 1.5;
}

/* Previous analyses */

.history-panel {
padding-top: 24px;
}

.previous-list {
display: flex;
flex-direction: column;
gap: 10px;
margin-top: 15px;
}

.previous-item {
padding: 14px;
border: 1px solid #e5eaf1;
border-radius: 10px;
}

.previous-top {
display: flex;
align-items: center;
justify-content: space-between;
gap: 10px;
}

.previous-top strong {
font-size: 13px;
}

.previous-top span {
color: #8a95a5;
font-size: 11px;
}

.previous-item p {
margin: 8px 0 0;
color: #4b5563;
font-size: 13px;
}

.safety-label {
display: inline-block;
margin-top: 9px;
padding: 4px 7px;
border-radius: 6px;
background: #fee2e2;
color: #b91c1c;
font-size: 10px;
font-weight: 700;
}

/* Responsive */

@media (max-width: 900px) {
.dashboard-grid {
grid-template-columns: 1fr;
}

.patients-panel {
order: 1;
}

.analysis-panel {
order: 2;
}

.patient-list {
display: grid;
grid-template-columns: repeat(2, 1fr);
}
}

@media (max-width: 650px) {
.topbar {
padding: 14px 16px;
}

.doctor-info {
display: none;
}

.dashboard {
padding: 20px 14px;
}

.login-card {
padding: 26px 20px;
}

.history-grid {
grid-template-columns: 1fr;
}

.patient-list {
grid-template-columns: 1fr;
}

.analysis-panel {
padding: 18px;
}

.result-header {
flex-direction: column;
}
}